# Riot Games API key (development key expires every 24 h; apply for production key)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Regions to crawl (platform routing) and their regional routing for Match-V5
REGIONS=eun1,euw1
QUEUE_ID=420

# Postgres (Supabase connection string, use the pooler URL in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/draft_advisor

# Rate limits of your key (dev key: 20/1s, 100/120s)
RIOT_RATE_PER_SECOND=20
RIOT_RATE_PER_2MIN=100
